<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analisis Bisnis Sewa Excavator Bogor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Chosen Palette: Construction Professional (Slate, Amber, and Neutral Warm) -->
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .chart-container {
            position: relative;
            width: 100%;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            height: 300px;
            max-height: 400px;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        .nav-item.active {
            border-bottom: 2px solid #f59e0b;
            color: #b45309;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
    </style>
</head>
<body class="min-h-screen">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-white shadow-sm px-6 py-4">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-2">
                <img src="https://www.excavatorbogor.web.id/icon.png" alt="Logo" class="w-10 h-10 object-contain rounded" />
                <h1 class="text-xl font-bold tracking-tight">Sewa Excavator <span class="text-amber-600">Bogor</span></h1>
            </div>
            <div class="flex gap-6 text-sm font-medium text-slate-600" id="main-nav">
                <button onclick="showSection('overview')" class="nav-item active py-1 transition-all">Ikhtisar</button>
                <button onclick="showSection('pricing')" class="nav-item py-1 transition-all">Harga & Unit</button>
                <button onclick="showSection('calculator')" class="nav-item py-1 transition-all">Kalkulator Profit</button>
                <button onclick="showSection('strategy')" class="nav-item py-1 transition-all">BMC</button>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto p-6">
        
        <!-- Section: Overview -->
        <section id="overview" class="space-y-8 animate-fade-in">
            <div class="bg-amber-50 border-l-4 border-amber-500 p-6 rounded-r-lg">
                <h2 class="text-2xl font-bold text-amber-900 mb-2">Selamat Datang di Dashboard Bisnis</h2>
                <p class="text-amber-800 leading-relaxed">
                    Halaman ini merangkum seluruh parameter bisnis iklan sewa excavator Anda di wilayah Bogor. 
                    Gunakan dashboard ini untuk memantau potensi keuntungan, membandingkan efisiensi unit, 
                    dan mensimulasikan penawaran harga kepada klien sebelum melakukan closing.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="glass-card p-6 rounded-xl shadow-sm text-center">
                    <p class="text-sm text-slate-500 uppercase font-bold tracking-wider">Minimal Sewa</p>
                    <p class="text-4xl font-black text-slate-800 mt-2">25 <span class="text-lg font-normal">Jam</span></p>
                </div>
                <div class="glass-card p-6 rounded-xl shadow-sm text-center">
                    <p class="text-sm text-slate-500 uppercase font-bold tracking-wider">Target Margin/Jam</p>
                    <p class="text-4xl font-black text-amber-600 mt-2">Rp34k-40k</p>
                </div>
                <div class="glass-card p-6 rounded-xl shadow-sm text-center">
                    <p class="text-sm text-slate-500 uppercase font-bold tracking-wider">Wilayah Utama</p>
                    <p class="text-4xl font-black text-slate-800 mt-2">Bogor <span class="text-lg font-normal">Raya</span></p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
                <div class="space-y-4">
                    <h3 class="text-xl font-bold border-b pb-2">Komponen Biaya Operasional</h3>
                    <ul class="space-y-3">
                        <li class="flex justify-between items-center p-3 bg-white rounded-lg border border-slate-100">
                            <span>🚚 Mob-Demob (PP)</span>
                            <span class="font-semibold text-slate-700">Rp2.000.000 - Rp2.500.000</span>
                        </li>
                        <li class="flex justify-between items-center p-3 bg-white rounded-lg border border-slate-100">
                            <span>👷 Honor Operator</span>
                            <span class="font-semibold text-slate-700">Rp250.000 / Hari</span>
                        </li>
                        <li class="flex justify-between items-center p-3 bg-white rounded-lg border border-slate-100">
                            <span>⛽ Bahan Bakar (BBM)</span>
                            <span class="font-semibold text-slate-700">± 50-70 Liter / Hari</span>
                        </li>
                    </ul>
                </div>
                <div class="glass-card p-6 rounded-xl shadow-sm">
                    <h3 class="text-lg font-bold mb-4 text-center">Distribusi Biaya per Hari (Estimasi)</h3>
                    <div class="chart-container">
                        <canvas id="costDistributionChart"></canvas>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section: Pricing & Units -->
        <section id="pricing" class="hidden space-y-8 animate-fade-in">
            <div class="text-center max-w-2xl mx-auto">
                <h2 class="text-3xl font-bold mb-4">Perbandingan Unit & Margin</h2>
                <p class="text-slate-600">Analisis selisih antara harga vendor (modal) dengan harga yang Anda iklankan di website untuk menentukan profitabilitas per jam.</p>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
                <div class="glass-card p-6 rounded-xl shadow-sm">
                    <div class="chart-container" style="height: 350px;">
                        <canvas id="pricingComparisonChart"></canvas>
                    </div>
                </div>
                <div class="overflow-x-auto glass-card rounded-xl shadow-sm">
                    <table class="w-full text-left">
                        <thead class="bg-slate-50 border-b">
                            <tr>
                                <th class="p-4 font-bold text-slate-700">Tipe Unit</th>
                                <th class="p-4 font-bold text-slate-700">Harga Iklan</th>
                                <th class="p-4 font-bold text-slate-700">Margin</th>
                                <th class="p-4 font-bold text-slate-700">Kapasitas</th>
                            </tr>
                        </thead>
                        <tbody id="unitTableBody" class="divide-y">
                            <!-- JS Injected -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- Section: Calculator -->
        <section id="calculator" class="hidden space-y-8 animate-fade-in">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold mb-6 text-center">Simulasi Keuntungan Proyek</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-white p-8 rounded-2xl shadow-lg border border-slate-100">
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Pilih Tipe Unit</label>
                            <select id="calc-unit" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-amber-500 transition-all">
                                <option value="34000">Komatsu PC75 (Margin Rp34k/jam)</option>
                                <option value="40000">Komatsu PC78 (Margin Rp40k/jam)</option>
                                <option value="40000">XCMG 60G Pro (Margin Rp40k/jam)</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-2">Total Jam Sewa (Min 25)</label>
                            <input type="number" id="calc-hours" value="25" min="25" class="w-full p-3 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-amber-500">
                        </div>
                        <div class="pt-4 border-t border-slate-100">
                            <h4 class="font-bold text-slate-800 mb-2">Catatan Operasional:</h4>
                            <ul class="text-sm text-slate-600 space-y-1">
                                <li>• Biaya Mob-Demob dibayar klien ke Vendor.</li>
                                <li>• Operator & BBM disediakan Vendor/Klien.</li>
                                <li>• Keuntungan Anda murni dari markup per jam.</li>
                            </ul>
                        </div>
                    </div>

                    <div class="bg-amber-50 p-6 rounded-xl flex flex-col justify-center items-center text-center space-y-4">
                        <p class="text-amber-800 font-bold uppercase tracking-widest text-sm">Estimasi Komisi Anda</p>
                        <p id="total-profit-display" class="text-5xl font-black text-amber-600">Rp0</p>
                        <div class="w-full h-2 bg-amber-200 rounded-full mt-4">
                            <div id="profit-progress" class="h-full bg-amber-500 rounded-full transition-all duration-500" style="width: 0%"></div>
                        </div>
                        <p class="text-xs text-amber-700 italic mt-2">Komisi ini ditransfer setelah pelunasan unit.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Section: Strategy BMC -->
        <section id="strategy" class="hidden space-y-8 animate-fade-in">
            <h2 class="text-3xl font-bold mb-8 text-center">Business Model Canvas</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Value Prop -->
                <div class="glass-card p-6 rounded-xl border-t-4 border-amber-500 shadow-sm">
                    <h3 class="font-bold text-lg mb-3 flex items-center gap-2">Value Propositions</h3>
                    <ul class="text-sm space-y-2 text-slate-600">
                        <li>• Konsultasi unit cepat (WhatsApp)</li>
                        <li>• Transparansi biaya (BBM, Mob)</li>
                        <li>• Akses unit lincah untuk galian sempit</li>
                    </ul>
                </div>
                <!-- Customer Segment -->
                <div class="glass-card p-6 rounded-xl border-t-4 border-amber-500 shadow-sm">
                    <h3 class="font-bold text-lg mb-3 flex items-center gap-2">Customer Segments</h3>
                    <ul class="text-sm space-y-2 text-slate-600">
                        <li>• Kontraktor proyek drainase</li>
                        <li>• Pemilik lahan pribadi (pematangan)</li>
                        <li>• Developer perumahan kecil-menengah</li>
                    </ul>
                </div>
                <!-- Key Partners -->
                <div class="glass-card p-6 rounded-xl border-t-4 border-amber-500 shadow-sm">
                    <h3 class="font-bold text-lg mb-3 flex items-center gap-2">Key Partners</h3>
                    <ul class="text-sm space-y-2 text-slate-600">
                        <li>• Pak Firhan (Pool Cibinong)</li>
                        <li>• Operator & Supir Self-Loader</li>
                        <li>• Google Ads (Traffic Source)</li>
                    </ul>
                </div>
                <!-- Revenue Stream -->
                <div class="glass-card p-6 rounded-xl border-t-4 border-amber-500 shadow-sm">
                    <h3 class="font-bold text-lg mb-3 flex items-center gap-2">Revenue Streams</h3>
                    <ul class="text-sm space-y-2 text-slate-600">
                        <li>• Markup Sewa (Rp34k - 40k / jam)</li>
                        <li>• Potensi Referral Fee (Dump Truck)</li>
                    </ul>
                </div>
                <!-- Channels -->
                <div class="glass-card p-6 rounded-xl border-t-4 border-amber-500 shadow-sm">
                    <h3 class="font-bold text-lg mb-3 flex items-center gap-2">Channels</h3>
                    <ul class="text-sm space-y-2 text-slate-600">
                        <li>• Website: excavatorbogor.web.id</li>
                        <li>• Google Maps & Business Profile</li>
                        <li>• WhatsApp Business</li>
                    </ul>
                </div>
                <!-- Key Activities -->
                <div class="glass-card p-6 rounded-xl border-t-4 border-amber-500 shadow-sm">
                    <h3 class="font-bold text-lg mb-3 flex items-center gap-2">Key Activities</h3>
                    <ul class="text-sm space-y-2 text-slate-600">
                        <li>• Digital Marketing & SEO</li>
                        <li>• Kualifikasi Lead (Cek Medan)</li>
                        <li>• Koordinasi Jadwal Vendor</li>
                    </ul>
                </div>
            </div>
        </section>

    </main>

    <footer class="mt-12 py-8 bg-slate-900 text-slate-400 text-center">
        <p class="text-sm">&copy; 2026 Analisis Bisnis Sewa Excavator Bogor | Private Dashboard</p>
    </footer>

    <script>
        // Data Configuration
        const unitData = [
            { type: 'Komatsu PC75', modal: 125000, iklan: 159000, margin: 34000, desc: 'Lincah, bucket 75cm' },
            { type: 'Komatsu PC78', modal: 125000, iklan: 165000, margin: 40000, desc: 'Ideal cut & fill' },
            { type: 'XCMG 60G Pro', modal: 130000, iklan: 170000, margin: 40000, desc: 'Efisien, normalisasi' }
        ];

        // Navigation Logic
        function showSection(id) {
            document.querySelectorAll('section').forEach(s => s.classList.add('hidden'));
            document.getElementById(id).classList.remove('hidden');
            
            document.querySelectorAll('.nav-item').forEach(btn => {
                btn.classList.remove('active');
                if(btn.innerText.toLowerCase().includes(id === 'overview' ? 'ikhtisar' : id.substring(0,3))) {
                    btn.classList.add('active');
                }
            });

            // Re-render charts to fix responsive issues when revealing sections
            if(id === 'pricing') renderPricingChart();
            if(id === 'overview') renderCostChart();
        }

        // Initialize Table
        function populateTable() {
            const tbody = document.getElementById('unitTableBody');
            tbody.innerHTML = unitData.map(u => `
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="p-4">
                        <div class="font-bold text-slate-800">${u.type}</div>
                        <div class="text-xs text-slate-500">${u.desc}</div>
                    </td>
                    <td class="p-4 font-semibold text-slate-700">Rp${u.iklan.toLocaleString('id-ID')}/jam</td>
                    <td class="p-4">
                        <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-bold rounded">Rp${u.margin.toLocaleString('id-ID')}</span>
                    </td>
                    <td class="p-4 text-slate-600 text-sm">± 8 jam / hari</td>
                </tr>
            `).join('');
        }

        // Chart: Cost Distribution
        let costChart;
        function renderCostChart() {
            if(costChart) costChart.destroy();
            const ctx = document.getElementById('costDistributionChart').getContext('2d');
            costChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Sewa Alat (Net)', 'BBM (Solar)', 'Honor Operator'],
                    datasets: [{
                        data: [1000000, 800000, 250000], // Approx Daily for 8 hours
                        backgroundColor: ['#f59e0b', '#334155', '#94a3b8'],
                        borderWidth: 0
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } }
                    }
                }
            });
        }

        // Chart: Pricing Comparison
        let pricingChart;
        function renderPricingChart() {
            if(pricingChart) pricingChart.destroy();
            const ctx = document.getElementById('pricingComparisonChart').getContext('2d');
            pricingChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: unitData.map(u => u.type),
                    datasets: [
                        {
                            label: 'Harga Modal (Vendor)',
                            data: unitData.map(u => u.modal),
                            backgroundColor: '#94a3b8'
                        },
                        {
                            label: 'Harga Jual (Iklan)',
                            data: unitData.map(u => u.iklan),
                            backgroundColor: '#f59e0b'
                        }
                    ]
                },
                options: {
                    maintainAspectRatio: false,
                    responsive: true,
                    scales: {
                        y: { beginAtZero: false, min: 100000 }
                    },
                    plugins: {
                        legend: { position: 'top' }
                    }
                }
            });
        }

        // Calculator Logic
        function updateCalculator() {
            const margin = parseInt(document.getElementById('calc-unit').value);
            const hours = parseInt(document.getElementById('calc-hours').value) || 0;
            const total = margin * hours;
            
            document.getElementById('total-profit-display').innerText = `Rp${total.toLocaleString('id-ID')}`;
            
            // Progress Bar Logic (Max 10jt reference)
            const progress = Math.min((total / 5000000) * 100, 100);
            document.getElementById('profit-progress').style.width = `${progress}%`;
        }

        // Event Listeners
        document.getElementById('calc-unit').addEventListener('change', updateCalculator);
        document.getElementById('calc-hours').addEventListener('input', updateCalculator);

        // Bootstrap
        window.onload = () => {
            populateTable();
            renderCostChart();
            updateCalculator();
        };
    </script>
</body>
</html>
